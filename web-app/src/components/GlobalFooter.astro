---
const name = 'ABI Trading Platform'
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <p class="brand">© {year} {name}</p>
  <p class="disclaimer">A community project for Arena Breakout: Infinite.</p>
</footer>

<style>
  .site-footer {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 2rem 1rem;
    border-top: 1px solid var(--border-color);
    width: 100vw;
    margin-left: calc(50% - 50.5vw);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;

    p {
      margin: 0;

      &.disclaimer {
        font-size: 0.8rem;
        color: var(--text-secondary);
        opacity: 0.7;
      }
    }
  }
</style>
